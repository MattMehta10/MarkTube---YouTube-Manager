{
  "name": "marktube",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:content": "vite build --config vite.config.content.js",
    "build:sidebar": "vite build --config vite.config.sidebar.js",
    "build:background": "esbuild src/background/index.js --bundle --outfile=dist/assets/background.js --format=iife",
    "build:static": "node scripts/copy-static.js",
    "build": "rimraf dist && npm run build:content && npm run build:sidebar && npm run build:background && npm run build:static && node scripts/copy-manifest.js",
    "dev": "npm run build && concurrently \"vite build --config vite.config.content.js --watch\" \"vite build --config vite.config.sidebar.js --watch\""
  },
  "dependencies": {
    "events": "^3.3.0",
    "lottie-react": "^2.4.0",
    "nanoid": "^5.0.7",
    "pouchdb": "^8.0.1",
    "pouchdb-find": "^8.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-icons": "^5.3.0",
    "react-router-dom": "^6.26.0",
    "react-toastify": "^10.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "esbuild": "^0.28.1",
    "rimraf": "^5.0.5",
    "vite": "^8.1.5"
  }
}
